@Metadata.layer: #CORE
@Search.searchable: true
@UI: {
  headerInfo:{
   typeName: 'Item',
   typeNamePlural: 'Items',
   typeImageUrl: 'sap-icon://cart-5',
   title:{type: #STANDARD, value: 'ItemNumber' }
    }
}
annotate entity ZC_SalesOrderItem_IQ with
{

  @UI.facet: [{ purpose: #HEADER,type: #DATAPOINT_REFERENCE,targetQualifier: 'ProductId',position: 10 },
              { purpose: #HEADER,type: #DATAPOINT_REFERENCE,targetQualifier: 'Status', position: 20},
    { id: 'Items', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Items', position: 30 }
  ]



  @UI.hidden: true
  OrderUuid;

  @UI.hidden: true
  ItemUuid;
@UI.lineItem: [
  { position: 10, importance: #HIGH },

  {
    type: #FOR_ACTION,
    dataAction: 'ConfirmItem',
    label: 'Confirm',
    position: 200
  },
  {
    type: #FOR_ACTION,
    dataAction: 'CancelItem',
    label: 'Cancel',
    position: 210
  },
  {
    type: #FOR_ACTION,
    dataAction: 'DeliverItem',
    label: 'Deliver',
    position: 220
  }
]
@UI.identification: [
  { position: 10},

  {
    type: #FOR_ACTION,
    dataAction: 'ConfirmItem',
    label: 'Confirm'
  },
  {
    type: #FOR_ACTION,
    dataAction: 'CancelItem',
    label: 'Cancel'
  },
  {
    type: #FOR_ACTION,
    dataAction: 'DeliverItem',
    label: 'Deliver'
  }
]

  @Search.defaultSearchElement: true
  @EndUserText.label: 'Item Number'
  ItemNumber;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @Search.defaultSearchElement: true
  @EndUserText.label: 'Product ID'
  @UI.dataPoint:{qualifier: 'ProductId',title: 'Proudct ID' }
  ProductId;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @EndUserText.label: 'Quantity'
  OrderQuantity;

  @UI.lineItem: [{ position: 35 }]
  @UI.identification: [{ position: 35 }]
  @EndUserText.label: 'Unit'
  QuantityUnit;

  @UI.lineItem: [{ position: 45 }]
  @UI.identification: [{ position: 45 }]
  @EndUserText.label: 'Net Price'
  NetPrice;

  @UI.lineItem: [{ position: 55 }]
  @UI.identification: [{ position: 55 }]
  @EndUserText.label: 'Net Amount'
  NetAmount;

  @UI.lineItem: [{ position: 65 }]
  @UI.identification: [{ position: 65 }]
  @EndUserText.label: 'Tax Code'
  TaxCode;

  @UI.lineItem: [{ position: 75 }]
  @UI.identification: [{ position: 75 }]
  @EndUserText.label: 'Tax Amount'
  TaxAmount;

  @UI.lineItem: [{ position: 85 }]
  @UI.identification: [{ position: 85 }]
  @EndUserText.label: 'Local Currency '
  Currency;
  
  @UI.lineItem: [{ position: 95 }]
  @UI.identification: [{ position: 95 }]
  @EndUserText.label: 'Net Amount (USD)'
  NetAmountUSD;

  @UI.lineItem: [{ position: 105 }]
  @UI.identification: [{ position: 105 }]
  @EndUserText.label: 'Tax Amount (USD)'
  TaxAmountUSD;
  
  @UI.lineItem: [{ position: 115}]
  @UI.identification: [{ position: 115 }]
  @EndUserText.label: 'Requested Delivery Date'
  RequestedDeliveryDate;
  

  @UI.lineItem: [{ position: 125}]
  @EndUserText.label: 'Status'
  @UI.dataPoint:{qualifier: 'Status',title: 'Status' }
  ItemStatus;
  

}