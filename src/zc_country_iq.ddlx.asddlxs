@Metadata.layer: #CORE
@Search.searchable: true

@UI: {
  headerInfo: {
    typeName: 'Country',
    typeNamePlural: 'Countries',
    typeImageUrl: 'sap-icon://globe',
    title: {
      type: #STANDARD,
      value: 'CountryName'
    }
  }
}

annotate entity ZC_Country_iq with
{

  @UI.facet: [
    {
      id: 'CountryInfo',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Country Information',
      position: 10
    }
  ]

  @UI.hidden: true
  CreatedBy;

  @UI.hidden: true
  CreatedAt;

  @UI.hidden: true
  ChangedBy;

  @UI.hidden: true
  ChangedAt;

  @UI.lineItem: [
    { position: 10, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 10 }
  ]
  @Search.defaultSearchElement: true
  @EndUserText.label: 'Country Code'
  @Consumption.valueHelpDefinition: [
  {
   entity: {
     name    : 'I_CountryVH',
     element : 'Country'
   }
  }
  ]
  CountryCode;


  @UI.lineItem: [
    { position: 20, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 20 }
  ]
  @Search.defaultSearchElement: true
  @EndUserText.label: 'Country Name'
  CountryName;

  @UI.lineItem: [
    { position: 30 }
  ]
  @UI.identification: [
    { position: 30 }
  ]
  @EndUserText.label: 'Currency Code'
  @Consumption.valueHelpDefinition: [
{
  entity: {
    name    : 'I_Currency',
    element : 'Currency'
  }
}
]
CurrencyCode;
 

  @UI.lineItem: [
    { position: 40 }
  ]
  @UI.identification: [
    { position: 40 }
  ]
  @EndUserText.label: 'Active'
  @UI.dataPoint: {
    title: 'Status'
  }
  IsActive;

}