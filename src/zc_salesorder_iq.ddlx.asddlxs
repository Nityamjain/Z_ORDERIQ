  Currency;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  @EndUserText.label: 'Net Amount (USD)'
  NetAmount;

  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  @EndUserText.label: 'TAX Amount (USD)'
  TaxAmount;

  @UI.lineItem: [{ position: 70 }]
  @UI.identification: [{ position: 70 }]
  @EndUserText.label: 'Total Amount (USD)'
  TotalAmount;
  
  @EndUserText.label: 'Credit Limit (Customer Local)'
  CreditLimit;
  
  @EndUserText.label: 'Credit Limit (USD)'
