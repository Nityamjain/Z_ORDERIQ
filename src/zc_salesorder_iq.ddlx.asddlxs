@Metadata.layer: #CORE
@Search.searchable: true
@UI: {
  headerInfo:{
   typeName: 'Orders',
   typeNamePlural: 'Orders',
   typeImageUrl: 'sap-icon://my-sales-order',
   title:{type: #STANDARD, value: 'OrderId' }
}
}

annotate entity ZC_SalesOrder_IQ with
{
  @UI.facet: [{ purpose: #HEADER,type: #DATAPOINT_REFERENCE,targetQualifier: 'CustomerId',position: 10 },
              { purpose: #HEADER,type: #DATAPOINT_REFERENCE,targetQualifier: 'CLUSD',position: 20 },
              { purpose: #HEADER,type: #DATAPOINT_REFERENCE,targetQualifier: 'Status', position: 30},
    { id: 'Orders', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Orders', position: 40 },
    { id: 'Items', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Items', position: 50, targetElement: '_Items' }
  ]

  @UI.hidden: true
  OrderUuid;
  
  
  @UI.lineItem: [
  { position: 10, importance: #HIGH },
  {
    type: #FOR_ACTION,
    dataAction: 'ReleaseOrder',
    label: 'Release',
    position: 100
  },
  {
    type: #FOR_ACTION,
    dataAction: 'RejectOrder',
    label: 'Reject',
    position: 110
  },
  {
    type: #FOR_ACTION,
    dataAction: 'CancelOrder',
    label: 'Cancel',
    position: 120
  },
  {
    type: #FOR_ACTION,
    dataAction: 'CompleteOrder',
    label: 'Complete',
    position: 130
  }
]
@UI.identification: [
  { position: 10 },

  {
    type: #FOR_ACTION,
    dataAction: 'ReleaseOrder',
    label: 'Release'
  },

  {
    type: #FOR_ACTION,
    dataAction: 'RejectOrder',
    label: 'Reject'
  },

  {
    type: #FOR_ACTION,
    dataAction: 'CancelOrder',
    label: 'Cancel'
  },

  {
    type: #FOR_ACTION,
    dataAction: 'CompleteOrder',
    label: 'Complete'
  }
]
  @Search.defaultSearchElement: true
  @EndUserText.label: 'Order ID'
  OrderId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @Search.defaultSearchElement: true
  @EndUserText.label: 'Customer ID'
  @UI.dataPoint:{qualifier: 'CustomerId',title: 'Customer ID' }
  CustomerId;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @Search.defaultSearchElement: true
  @EndUserText.label: 'Order Date'
  OrderDate;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @Search.defaultSearchElement: true
